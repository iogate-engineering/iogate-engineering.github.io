/* styles.css */
:root{
  --bg: #403F4C;          /* gunmetal */
  --text: #ffffff;
  --muted: rgba(255,255,255,0.72);
  --muted2: rgba(255,255,255,0.45);
  --blue: #3185FC;
  --purple: #7A5CFF;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(1200px 800px at 20% 20%, rgba(49,133,252,0.18), transparent 55%),
    radial-gradient(1200px 800px at 80% 80%, rgba(122,92,255,0.16), transparent 55%),
    var(--bg);
  color: var(--text);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  overflow-x: hidden;
}

.content{
  max-width: 1200px;
  margin: 0 auto;
}

.wrap{
  width: min(1300px, 94vw);
  padding: 56px 32px;
  position: relative;
  margin: 0 auto;
}

/* Subtle “gate” lines */
.wrap::before,
.wrap::after{
  content:"";
  position:absolute;
  inset: -40px;
  border-radius: 24px;
  pointer-events: none;
  opacity: 0.9;
}

.wrap::before{
  border: 1px solid rgba(255,255,255,0.08);
  background:
    linear-gradient(to right, rgba(255,255,255,0.06) 1px, transparent 1px) 0 0/32px 32px,
    linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px) 0 0/32px 32px;
  mask: radial-gradient(circle at 50% 45%, rgba(0,0,0,1) 0 38%, rgba(0,0,0,0) 70%);
}

.wrap::after{
  background:
    radial-gradient(circle at 50% 45%, rgba(49,133,252,0.25), transparent 40%),
    radial-gradient(circle at 50% 45%, rgba(122,92,255,0.20), transparent 55%);
  filter: blur(18px);
  opacity: 0.55;
  animation: drift 9s ease-in-out infinite;
}

@keyframes drift{
  0%,100% { transform: translateY(0px); }
  50%     { transform: translateY(10px); }
}

.logo{
  margin-bottom: 24px;
  font-size: clamp(2.6rem, 6vw, 4rem);
  letter-spacing: 0.5px;
  margin: 0 0 14px 0;
  line-height: 1.05;
  display: inline-block;
  position: relative;
  z-index: 1;
}

.logo .io{
  background: linear-gradient(90deg, var(--blue), var(--purple));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 0 28px rgba(49,133,252,0.18);
}

.tagline{
  margin: 0 0 8px 0;
  font-size: clamp(0.98rem, 2.2vw, 1.18rem);
  color: var(--muted);
  max-width: none; 
  position: relative;
  z-index: 1;
}

/* Rotating words */
.rotator{
  display: inline-block;
  position: relative;
  width: 9ch;                 /* prevents layout shift; tweak if needed */
  margin: 0 0.15em;
  height: 1.2em;
  vertical-align: baseline;
}

.rotator__word{
  display: inline-block;
  font-weight: 600;
  background: linear-gradient(90deg, var(--blue), var(--purple));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 0 28px rgba(49,133,252,0.12);
  transition: opacity 320ms ease, transform 320ms ease;
  will-change: opacity, transform;
}

.rotator__word.is-fading{
  opacity: 0;
  transform: translateY(6px);
}

/* Respect reduced motion */
@media (prefers-reduced-motion: reduce){
  .rotator__word{
    transition: none;
  }
}

.meta{
  display: flex;
  flex-wrap: wrap;
  gap: 10px 14px;
  align-items: center;
  margin-top: 18px;
  margin-bottom: 20px;
  color: var(--muted2);
  font-size: 0.9rem;
  position: relative;
  z-index: 1;
}

.pill{
  border: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.04);
  padding: 8px 10px;
  border-radius: 999px;
  display: inline-flex;
  gap: 8px;
  align-items: center;
  white-space: nowrap;
}

.dot{
  width: 8px; height: 8px;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--blue), var(--purple));
  box-shadow: 0 0 12px rgba(49,133,252,0.35);
}

/* Nav pills */
.nav{
  margin-top: 18px;
  
  display: flex;
  flex-wrap: wrap;
  gap: 10px 12px;
  align-items: center;
  position: relative;
  z-index: 1;
}

.nav a{
  color: rgba(255,255,255,0.72);
  text-decoration: none;
  border: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.04);
  padding: 8px 10px;
  border-radius: 999px;
  display: inline-flex;
  gap: 8px;
  align-items: center;
}

.nav a:hover{
  color: rgba(255,255,255,0.92);
  border-color: rgba(255,255,255,0.18);
}

.nav a[aria-current="page"]{
  color: rgba(255,255,255,0.92);
  border-color: rgba(255,255,255,0.22);
  background: rgba(255,255,255,0.06);
}


.section{
  padding: 16px 0 0 0;
  position: relative;
  z-index: 1;
}

.section:first-of-type{
  margin-top: 24px;
}

.section h1{
  background: linear-gradient(90deg, var(--blue), var(--purple));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 0 28px rgba(49,133,252,0.18);

  margin: 0 0 10px 0;
  font-size: 2rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.section h2{
  background: linear-gradient(90deg, var(--blue), var(--purple));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 0 28px rgba(49,133,252,0.18);

  margin: 0 0 10px 0;
  font-size: 0.95rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.section p{
  margin: 0 0 12px 0;
  color: var(--muted);
  max-width: none; 
  line-height: 1.6;
}

.list{
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 12px;
}

.item{
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.03);
  border-radius: 16px;
  padding: 14px 14px;
}

.item strong{
  display: block;
  margin-bottom: 6px;
  color: rgba(255,255,255,0.92);
  font-weight: 700;
  letter-spacing: 0.2px;
}

.item span{
  color: var(--muted);
  line-height: 1.6;
  display: block;
}

.bullets{
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  line-height: 1.7;
}

.cta{
  margin-top: 80px;
  padding: 16px 16px;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.03);
  color: var(--muted);
  line-height: 1.7;
  position: relative;
  z-index: 1;
}

.cta a{
  color: rgba(255,255,255,0.90);
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.25);
}

.cta a:hover{
  color: #fff;
  border-bottom-color: rgba(255,255,255,0.55);
}

footer{
  margin-top: 34px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  color: rgba(255,255,255,0.38);
  font-size: 0.82rem;
  position: relative;
  z-index: 1;
}

.links a{
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  margin-left: 14px;
}

.links a:hover{
  color: rgba(255,255,255,0.85);
}

/* --- Clickable tiles (Who we work with) --- */

/* --- Vertical tile layout --- */

.tile-grid{
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 18px;
}

.tile{
  display: flex;
  flex-direction: column;
  text-decoration: none;
  border-radius: 18px;
  overflow: hidden;

  border: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.03);

  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
}

.tile:hover{
  transform: translateY(-4px);
  border-color: rgba(255,255,255,0.20);
  background: rgba(255,255,255,0.05);
}

/* image section */
.tile-image{
  height: 180px;
  overflow: hidden;
}

.tile-image img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 300ms ease;
}

.tile:hover .tile-image img{
  transform: scale(1.05);
}

/* text section */
.tile-body{
  padding: 16px;
}

.tile-kicker{
  font-size: 0.80rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  margin: 0 0 8px 0;
}

.tile-title{
  margin: 0 0 8px 0;
  font-size: 1.15rem;
  color: rgba(255,255,255,0.92);
}

.tile-desc{
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
  font-size: 0.95rem;
}

/* --- Vertical tiles: image on top, text underneath --- */

.tile-grid{
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 18px;
}

.tile{
  display: flex;
  flex-direction: column;
  text-decoration: none;
  border-radius: 18px;
  overflow: hidden;

  border: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.03);

  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
}

.tile:hover{
  transform: translateY(-4px);
  border-color: rgba(255,255,255,0.20);
  background: rgba(255,255,255,0.05);
}

.tile:focus-visible{
  outline: 2px solid rgba(49,133,252,0.55);
  outline-offset: 3px;
}

.tile-image{
  height: 210px;
  overflow: hidden;
  background: rgba(255,255,255,0.02);
}

.tile-image img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 300ms ease;
}

.tile:hover .tile-image img{
  transform: scale(1.05);
}

.tile-body{
  padding: 20px 18px 22px;
}

.tile-kicker{
  font-size: 0.80rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  margin: 0 0 8px 0;
}

.tile-title{
  margin: 0 0 8px 0;
  font-size: 1.2rem;
  font-weight: 600;
  line-height: 1.25;
  color: rgba(255,255,255,0.92);
}

.tile-desc{
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
  font-size: 0.95rem;
}

.tile{
  box-shadow: 0 6px 20px rgba(0,0,0,0.25);
}

.tile:hover{
  transform: translateY(-4px);
  border-color: rgba(255,255,255,0.20);
  background: rgba(255,255,255,0.05);
  box-shadow: 0 10px 30px rgba(0,0,0,0.35);
}

@media (max-width: 980px){
  .tile-grid{ grid-template-columns: 1fr; }
  .tile-image{ height: 180px; }
}

/* responsive */
@media (max-width: 980px){
  .tile-grid{
    grid-template-columns: 1fr;
  }
}

/* responsive */
@media (max-width: 980px){
  .tile-grid{ grid-template-columns: 1fr; }
  .tile{ min-height: 180px; }
}

/* Respect reduced motion */
@media (prefers-reduced-motion: reduce){
  .wrap::after{ animation: none; }
}

.article{
  max-width: 900px;
  margin: 0 auto;
  padding: 80px 0;
}

.article > h1{
  /* pick ONE of the two styles below */

  /* (A) Solid blue */
  color: var(--blue) !important;

  /* (B) Gradient (uncomment these 4 lines and comment out the solid blue line above)
  background: linear-gradient(90deg, var(--blue), var(--purple));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent !important;
  -webkit-text-fill-color: transparent;
  */

  display: inline-block; /* helps gradient rendering */
  margin: 0 0 20px 0;
  line-height: 1.15;
}

.article p{
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--muted);
  margin-bottom: 22px;
}