<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>iogate</title>
  <meta name="description" content="IOGate — secure cloud and platform engineering." />

  <style>
    :root{
      --bg: #403F4C;          /* gunmetal */
      --text: #ffffff;
      --muted: rgba(255,255,255,0.72);
      --muted2: rgba(255,255,255,0.45);
      --blue: #3185FC;
      --purple: #7A5CFF;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: radial-gradient(1200px 800px at 20% 20%, rgba(49,133,252,0.18), transparent 55%),
                  radial-gradient(1200px 800px at 80% 80%, rgba(122,92,255,0.16), transparent 55%),
                  var(--bg);
      color: var(--text);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      overflow-x: hidden;
    }

    .wrap{
      width: min(920px, 92vw);
      padding: 56px 28px;
      position: relative;
    }

    /* Subtle “gate” lines */
    .wrap::before,
    .wrap::after{
      content:"";
      position:absolute;
      inset: -40px;
      border-radius: 24px;
      pointer-events: none;
      opacity: 0.9;
    }

    .wrap::before{
      border: 1px solid rgba(255,255,255,0.08);
      background:
        linear-gradient(to right, rgba(255,255,255,0.06) 1px, transparent 1px) 0 0/32px 32px,
        linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px) 0 0/32px 32px;
      mask: radial-gradient(circle at 50% 45%, rgba(0,0,0,1) 0 38%, rgba(0,0,0,0) 70%);
    }

    .wrap::after{
      background: radial-gradient(circle at 50% 45%, rgba(49,133,252,0.25), transparent 40%),
                  radial-gradient(circle at 50% 45%, rgba(122,92,255,0.20), transparent 55%);
      filter: blur(18px);
      opacity: 0.55;
      animation: drift 9s ease-in-out infinite;
    }

    @keyframes drift{
      0%,100% { transform: translateY(0px); }
      50%     { transform: translateY(10px); }
    }

    .logo{
      font-size: clamp(2.6rem, 6vw, 4rem);
      letter-spacing: 0.5px;
      margin: 0 0 14px 0;
      line-height: 1.05;
      display: inline-block;
    }

    .logo .io{
      background: linear-gradient(90deg, var(--blue), var(--purple));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 28px rgba(49,133,252,0.18);
    }

    .tagline{
      margin: 0 0 26px 0;
      font-size: clamp(0.95rem, 2.2vw, 1.15rem);
      color: var(--muted);
      max-width: 58ch;
    }

    .meta{
      display: flex;
      flex-wrap: wrap;
      gap: 10px 14px;
      align-items: center;
      margin-top: 18px;
      color: var(--muted2);
      font-size: 0.9rem;
    }

    .pill{
      border: 1px solid rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.04);
      padding: 8px 10px;
      border-radius: 999px;
      display: inline-flex;
      gap: 8px;
      align-items: center;
    }

    .dot{
      width: 8px; height: 8px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--blue), var(--purple));
      box-shadow: 0 0 12px rgba(49,133,252,0.35);
    }

    footer{
      margin-top: 34px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      color: rgba(255,255,255,0.38);
      font-size: 0.82rem;
    }

    .links a{
      color: rgba(255,255,255,0.55);
      text-decoration: none;
      margin-left: 14px;
    }

    .links a:hover{
      color: rgba(255,255,255,0.85);
    }

    /* Respect reduced motion */
    @media (prefers-reduced-motion: reduce){
      .wrap::after{ animation: none; }
    }
  </style>
</head>

<body>
  <main class="wrap">
    <h1 class="logo"><span class="io">io</span>gate</h1>

    <p class="tagline">
      Secure cloud & platform engineering for organisations that need control, resilience, and clean delivery.
    </p>

    <div class="meta" aria-label="Brand metadata">
      <span class="pill"><span class="dot"></span> UK • Private sector</span>
      <span class="pill">AWS • Azure</span>
      <span class="pill">Security-led</span>
    </div>

<footer>
  <span>© <span id="y"></span> iogate</span>
  <span class="links">
    <a href="mailto:info@iogate.co.uk">info@iogate.co.uk</a>
  </span>
</footer>
  </main>

  <script>
    // keep it accurate without editing the file yearly
    document.getElementById("y").textContent = new Date().getFullYear();
  </script>
</body>
</html>